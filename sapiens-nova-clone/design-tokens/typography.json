{
  "source": "https://www.sapiens-nova.com — @font-face из /_astro/cancel.CsmBUkhm.css + Google Fonts preconnect",
  "font-faces": [
    { "family": "Tobias", "files": ["/fonts/Tobias-VF.ttf", "/fonts/Tobias-Italic-VF.ttf"], "weight": "100 900", "style": "normal/italic", "role": "Серифный шрифт заголовков (.font-serif)" },
    { "family": "Karla", "files": ["/fonts/Karla-VF.ttf"], "weight": "100 900", "style": "normal", "role": "Основной гротеск (.font-sans)" },
    { "family": "Mulish", "files": ["/fonts/Mulish-VF.ttf"], "weight": "variable", "style": "normal", "role": "Вспомогательный (не используется в видимых классах текущей версии)" }
  ],
  "font-stacks": {
    "serif": "Tobias, Palatino Linotype, Georgia, serif",
    "sans": "Karla, Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
  },
  "type-scale": {
    "h1-hero": { "mobile": "40px (2.5rem)", "sm": "48px (text-5xl)", "md": "60px (text-6xl)", "lg": "72px (text-7xl)", "weight": "400 normal", "family": "serif", "tracking": "-0.025em (tight)", "line-height": "1.1", "note": "text-shadow для читаемости на фото" },
    "h1-page": { "mobile": "36px (text-4xl)", "lg": "48px (text-5xl)", "weight": "400", "family": "serif", "line-height": "1.1", "note": "Programmes 'Unlock Your Future', чекаут 'Secure Your Spot'" },
    "h2-section": { "mobile": "36px (text-4xl)", "md": "48px (text-5xl)", "lg": "48px", "weight": "400 normal (serif)", "line-height": "1.1", "note": "Who We Are / Locations / Footer" },
    "h2-programs": { "mobile": "36px", "md": "44px (2.75rem)", "weight": "600 semibold", "family": "serif", "tracking": "-0.03em", "line-height": "1.2", "note": "'Comprehensive Programmes for Future Leaders'" },
    "h2-testimonials": { "mobile": "36px", "lg": "42.2px", "weight": "400", "family": "serif", "line-height": "1.2" },
    "h3-card": { "default": "20-24px (text-xl/2xl)", "weight": "400", "family": "serif", "line-height": "1.2" },
    "h4-programme": { "default": "30px (text-3xl)", "weight": "600", "family": "serif", "tracking": "-0.02em" },
    "body": { "default": "16px (text-base)", "lg": "20px (text-xl)", "weight": "400", "family": "sans", "line-height": "1.5-1.625 (relaxed)" },
    "body-large": { "default": "18px (text-lg)", "lg": "20px (text-xl)", "family": "sans", "line-height": "relaxed" },
    "small-uppercase-label": { "size": "14px (text-sm)", "weight": "500", "tracking": "0.05em (wide)", "uppercase": true, "family": "sans", "role": "Навигация, пилюли-бейджи" },
    "micro-uppercase": { "size": "10-12px", "weight": "400", "tracking": "0.1em (widest)", "uppercase": true, "role": "Подписи (Alex Chen / BAScii Student), кнопки" },
    "testimonial-quote": { "size": "15px", "line-height": "24px", "weight": "400", "family": "sans" },
    "testimonial-name": { "size": "17px", "line-height": "24px", "weight": "400", "family": "sans" }
  },
  "button-type": {
    "nav": "14px / 500 / uppercase / tracking-wide",
    "pill-badge": "16-20px / 400 / uppercase / tracking-wide",
    "btn-default": "14-16px / 500 / uppercase / tracking-wide, radius 30px (rounded-[30px])",
    "btn-lg": "16px / 500 / uppercase, radius 9999px (rounded-full), padding 48px 24px (px-12 py-6)"
  },
  "line-heights-tokens": { "tight": 1.25, "snug": 1.375, "normal": 1.5, "relaxed": 1.625, "h1-hero": 1.1, "h2": 1.1, "h2-programs": 1.2 }
}
